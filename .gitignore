# nybo runtime telemetry — high-frequency append-only log, not source
.nybo/events.jsonl
.nybo/state/*

# contains a live MCP bearer token — never commit secrets
.mcp.json
.nybo/foundation/integrations.yaml

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/

# Frontend
node_modules/
dist/
.vite/

# Android (Capacitor) — android/ itself IS committed (standard
# Capacitor convention), only its build artifacts/local machine config
# and signing keys are excluded.
android/app/build/
android/.gradle/
android/local.properties
android/app/release/
*.keystore
*.jks

# git worktrees created by nybo-orchestrate — each has its own .git, never commit
.claude/worktrees/

# Android Studio project metadata
android/.idea/
